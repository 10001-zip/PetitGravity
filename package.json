{
  "name": "petitgravity",
  "version": "1.0.0",
  "description": "Antigravity 2 Desktop app Quota monitor and notifier",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "antigravity",
    "quota",
    "electron"
  ],
  "author": "Antigravity Helper",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.antigravity.quotamonitor",
    "asarUnpack": [
      "src/helpers/**/*.ps1"
    ],
    "publish": null,
    "win": {
      "target": "nsis",
      "icon": "logo1_rounded.ico"
    },
    "mac": {
      "icon": "logo_rounded.png"
    },
    "linux": {
      "icon": "logo_rounded.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "sortablejs": "^1.15.7",
    "sql.js": "^1.14.1"
  }
}
