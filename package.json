{
  "name": "petitgravity",
  "version": "0.1.2",
  "description": "Antigravity 2 Desktop app Quota monitor and notifier",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "node scripts/build.js"
  },
  "keywords": [
    "antigravity",
    "quota",
    "electron"
  ],
  "author": "Antigravity Helper",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1",
    "nodemon": "^3.1.14"
  },
  "build": {
    "files": [
      "src/**/*",
      "package.json",
      "logo1_rounded.ico",
      "logo_rounded.png"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "artifactName": "${name}-Setup-${version}.${ext}",
    "appId": "com.antigravity.quotamonitor",
    "asarUnpack": [
      "src/helpers/**/*.ps1"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "10001-zip",
        "repo": "PetitGravity"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "logo1_rounded.ico"
    },
    "mac": {
      "icon": "logo_rounded.png"
    },
    "linux": {
      "icon": "logo_rounded.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sortablejs": "^1.15.7",
    "sql.js": "^1.14.1"
  }
}
